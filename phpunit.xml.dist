<?xml version="1.0"?>
<phpunit bootstrap="tests/php/bootstrap.php" colors="true">
    <testsuites>
        <testsuite name="post-voice">
            <!--
                Explicit suffix: this project follows WordPress's `test-*.php`
                file naming, not PHPUnit's default `*Test.php`, so without it
                PHPUnit silently discovers nothing and reports success.
            -->
            <directory suffix=".php">features/narration/tests/php</directory>
            <directory suffix=".php">features/pronunciation/tests/php</directory>
            <directory suffix=".php">shared/tests/php</directory>
            <!--
                features/player-style/tests/php is not listed yet: unlike
                `wp i18n make-pot`, this PHPUnit version (9.6) throws
                TestDirectoryNotFoundException for a <directory> that does not
                exist, rather than skipping it. Add the entry in the task that
                creates the directory.
            -->
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory suffix=".php">features</directory>
            <directory suffix=".php">shared</directory>
        </include>
        <exclude>
            <directory suffix=".php">features/narration/tests</directory>
            <directory suffix=".php">features/pronunciation/tests</directory>
            <directory suffix=".php">features/player-style/tests</directory>
            <directory suffix=".php">shared/tests</directory>
        </exclude>
        <report>
            <clover outputFile="coverage/clover.xml"/>
        </report>
    </coverage>
</phpunit>
